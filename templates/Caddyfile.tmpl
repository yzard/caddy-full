{{- $fallback := env "FALLBACK_PROXY" -}}
{{- $sshSplitter := eq (env "SSH_SPLITTER") "true" -}}
{{- $bepTarget := "" -}}
{{- $selfID := env "CADDY_SELF_ID" -}}
{{- $selfFound := false -}}
{{- range $ -}}
  {{- if and $selfID (eq .ID $selfID) -}}
    {{- $selfFound = true -}}
    {{- $bepTarget = index .Labels "bep_host_port" | default "" -}}
  {{- end -}}
{{- end -}}
{{- if and $selfID (not $selfFound) -}}
  {{- fail "Waiting for the proxy container to appear in Docker" -}}
{{- end -}}
{{- if $bepTarget -}}
  {{- if not (regexMatch "^[a-zA-Z0-9._-]+:[0-9]{1,5}$|^\\[[0-9a-fA-F:]+\\]:[0-9]{1,5}$" $bepTarget) -}}
    {{- fail "bep_host_port must be a host:port address" -}}
  {{- end -}}
  {{- $port := atoi (last (splitList ":" $bepTarget)) -}}
  {{- if or (lt $port 1) (gt $port 65535) -}}
    {{- fail "bep_host_port must use a port between 1 and 65535" -}}
  {{- end -}}
{{- end -}}
{{- $layer4 := or $fallback $sshSplitter $bepTarget -}}
{{- $httpsPort := env "HTTPS_PORT" | default (ternary "8443" "443" (not (empty $layer4))) -}}
{{- if and $layer4 (eq (atoi $httpsPort) 443) -}}
  {{- fail "Layer 4 reserves port 443. Leave HTTPS_PORT unset or use a different internal port." -}}
{{- end -}}
{{- $instance := env "CADDY_INSTANCE" -}}
{{- $containers := $ -}}
{{- if $instance -}}
  {{- $containers = whereLabelValueMatches $ "caddy.instance" (printf "^%s$" (regexQuoteMeta $instance)) -}}
{{- end -}}
{{- $hosts := list -}}
{{- range $container := $containers -}}
  {{- range $label, $val := $container.Labels -}}
    {{- if and (hasPrefix "caddy." $label) (hasSuffix ".domain" $label) -}}
      {{- range $domain := regexSplit "[\\s,]+" (trim $val) -1 -}}
        {{- if $domain -}}
          {{- $host := regexReplaceAll "^https?://" $domain "" -}}
          {{- $host = regexReplaceAll ":[0-9]+$" $host "" -}}
          {{- $hosts = append $hosts $host -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range $host := regexSplit "[\\s,]+" (trim (env "LOCAL_DOMAINS")) -1 -}}
  {{- if $host -}}{{- $hosts = append $hosts $host -}}{{- end -}}
{{- end -}}
{{- $hosts = uniq $hosts | sortAlpha -}}
{
    {{ if $layer4 }}auto_https disable_redirects{{ end }}
    http_port 80
    https_port {{ $httpsPort }}
    # TLS routing uses TCP. Do not advertise an unreachable HTTP/3 endpoint.
    servers {
        protocols h1 h2
        strict_sni_host on
    }
    {{ if eq (env "TLS_ALPN_ONLY") "true" }}
    cert_issuer acme {
        disable_http_challenge
    }
    {{ end }}
    {{ if env "ACME_CA" }}acme_ca {{ env "ACME_CA" }}{{ end }}
    {{ if env "ACME_CA_ROOT" }}acme_ca_root {{ env "ACME_CA_ROOT" }}{{ end }}
    {{ if $layer4 }}
    layer4 {
        :443 {
            {{ if $sshSplitter }}
            @ssh ssh
            route @ssh {
                proxy {{ env "SSH_PROXY" }}
            }
            {{ end }}
            {{ if $bepTarget }}
            @bep tls alpn bep/1.0
            route @bep {
                proxy {{ $bepTarget }}
            }
            {{ end }}
            {{ if $fallback }}
            {{ if $hosts }}
            @known tls sni {{ join " " $hosts }}
            route @known {
                proxy 127.0.0.1:{{ $httpsPort }}
            }
            {{ end }}
            @fallback tls
            route @fallback {
                proxy {{ $fallback }}
            }
            {{ else }}
            @https tls
            route @https {
                proxy 127.0.0.1:{{ $httpsPort }}
            }
            {{ end }}
            {{ if $sshSplitter }}
            @http http
            route @http {
                proxy 127.0.0.1:80
            }
            {{ end }}
        }
    }
    {{ end }}
}

# Named sites take precedence over these catch-all routes.
:80 {
    redir https://{host}{uri} permanent
}

:{{ $httpsPort }} {
    respond "Not Found" 404
}

{{ $routesBySite := dict }}
{{ range $container := $containers }}
  {{ $name := $container.Name }}
  {{ range $label, $val := $container.Labels }}
    {{ if not (and (hasPrefix "caddy." $label) (hasSuffix ".domain" $label)) }}{{ continue }}{{ end }}
    {{ $idx := trimSuffix ".domain" (trimPrefix "caddy." $label) }}
    {{ $base := print "caddy." $idx "." }}
    {{ $port := index $container.Labels (print $base "port") | default "80" }}
    {{ $tls := index $container.Labels (print $base "tls") }}
    {{ $rewrite := index $container.Labels (print $base "rewrite") }}
    {{ $paths := index $container.Labels (print $base "paths") }}
    {{ range $site := regexSplit "[\\s,]+" (trim $val) -1 }}
      {{ if $site }}
        {{ if $layer4 }}
          {{ if or (hasPrefix "http://" $site) (and (regexMatch ":[0-9]+$" $site) (not (hasSuffix ":443" $site))) }}
            {{ fail (printf "Layer 4 requires HTTPS sites on public port 443, got %q on %s" $site $name) }}
          {{ end }}
          {{ $site = trimSuffix ":443" $site }}
        {{ end }}
        {{ $routes := get $routesBySite $site | default (list) }}
        {{ $route := dict "name" $name "port" $port "tls" $tls "rewrite" $rewrite "paths" $paths }}
        {{ $_ := set $routesBySite $site (append $routes $route) }}
      {{ end }}
    {{ end }}
  {{ end }}
{{ end }}

{{ range $site, $routes := $routesBySite }}
  {{ $tls := "" }}
  {{ range $route := $routes }}
    {{ if $route.tls }}
      {{ if and $tls (ne $tls $route.tls) }}
        {{ fail (printf "Conflicting TLS labels for %s" $site) }}
      {{ end }}
      {{ $tls = $route.tls }}
    {{ end }}
  {{ end }}
{{ $site }} {
    log {
        output stdout
    }
    encode br gzip zstd
    {{ if and (eq (env "TLS_ALPN_ONLY") "true") (or (not $tls) (regexMatch "^[^\\s]+@[^\\s]+$" $tls)) }}
    tls {
        issuer acme {
            {{ if $tls }}email {{ $tls }}{{ end }}
            disable_http_challenge
        }
    }
    {{ else if $tls }}tls {{ $tls }}{{ end }}
    {{ if eq (len $routes) 1 }}
    {{ $route := first $routes }}
    {{ $name := $route.name }}
    {{ $port := $route.port }}
    {{ $paths := $route.paths }}
    {{ if $route.rewrite }}rewrite {{ $route.rewrite }}{{ end }}
    {{ if $paths }}
    route {
      {{ range $index, $pair := split $paths "," }}
        {{ $parts := split $pair ":" }}
        {{ if ne (len $parts) 2 }}{{ fail (printf "Invalid path:port pair %q on %s" $pair $name) }}{{ end }}
        {{ $path := trim (index $parts 0) }}
        {{ $pathPort := trim (index $parts 1) }}
        @path{{ $index }} path /{{ $path }}/* /{{ $path }}
        reverse_proxy @path{{ $index }} {{ $name }}:{{ $pathPort }}
      {{ end }}
        abort
    }
    {{ else }}
    reverse_proxy {{ $name }}:{{ $port }}
    {{ end }}
    {{ else }}
      {{ $byPath := dict }}
      {{ range $route := $routes }}
        {{ if not $route.paths }}
          {{ fail (printf "Shared site %s requires caddy.N.paths on %s" $site $route.name) }}
        {{ end }}
        {{ range $pair := splitList "," $route.paths }}
          {{ $parts := splitList ":" $pair }}
          {{ if ne (len $parts) 2 }}
            {{ fail (printf "Invalid path:port pair %q on %s" $pair $route.name) }}
          {{ end }}
          {{ $path := trim (index $parts 0) }}
          {{ $pathPort := trim (index $parts 1) }}
          {{ if not (regexMatch "^[a-zA-Z0-9_~-]+(/[a-zA-Z0-9_~-]+)*$" $path) }}
            {{ fail (printf "Invalid path label %q for shared site %s" $path $site) }}
          {{ end }}
          {{ $key := lower $path }}
          {{ if hasKey $byPath $key }}
            {{ fail (printf "Duplicate path /%s for shared site %s" $path $site) }}
          {{ end }}
          {{ $_ := set $byPath $key (dict "path" $path "name" $route.name "port" $pathPort "rewrite" $route.rewrite) }}
        {{ end }}
      {{ end }}
    route {
      {{ range $index, $key := keys $byPath | sortAlpha | reverse }}
        {{ $route := get $byPath $key }}
        @path{{ $index }} path /{{ $route.path }} /{{ $route.path }}/*
        handle @path{{ $index }} {
            {{ if $route.rewrite }}rewrite {{ $route.rewrite }}{{ end }}
            reverse_proxy {{ $route.name }}:{{ $route.port }}
        }
      {{ end }}
        abort
    }
    {{ end }}
}
{{ end }}
